:root{color-scheme:dark;--bg:#0b1120;--panel:#121c30;--text:#f4f7ff;--muted:#a9b6cc;--blue:#72a5ff;--line:#26344c;--green:#70e1bd}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.65}
a{color:inherit;text-decoration:none}
.topbar{height:76px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:#0b1120}
.brand{font-size:19px;font-weight:800;letter-spacing:-.5px}.brand span{color:var(--blue)}
.nav-contact{font-size:14px;color:var(--blue);font-weight:650}
.hero{padding:94px 8% 76px;max-width:1150px;margin:auto}
.eyebrow{font-size:11px;letter-spacing:2px;font-weight:800;color:var(--blue)}
.dot{display:inline-block;width:7px;height:7px;background:var(--green);border-radius:50%;margin-right:8px}
h1{font-size:clamp(36px,7vw,66px);line-height:1.12;letter-spacing:-2px;margin:20px 0;max-width:850px}
h1 span{color:var(--blue)}
.intro{font-size:17px;color:#c1cce0;max-width:650px}
.urdu{color:#c4d0e4;line-height:2}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin:27px 0}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 19px;border-radius:9px;font-size:14px;font-weight:750;min-height:46px}
.primary{background:var(--blue);color:#0b1120}.secondary{border:1px solid #465671;color:var(--text)}
.hero-note{font-size:12px;color:var(--muted);margin-top:35px}.hero-note span{color:var(--green);padding:0 8px}
.section{padding:70px 8%;max-width:1250px;margin:auto}
.section-heading{margin-bottom:30px}.section-heading h2,.contact-section h2{font-size:clamp(27px,4vw,40px);line-height:1.2;margin:9px 0 12px;letter-spacing:-1px}
.section-heading>p:last-child,.contact-section>p:not(.eyebrow){color:var(--muted);max-width:650px}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:24px}
.card-icon{color:var(--green);font-size:27px}.card h3,.project h3{font-size:18px;margin:12px 0 8px}.card p,.project-info p{font-size:14px;color:var(--muted)}
.projects{border-top:1px solid var(--line);border-bottom:1px solid var(--line);max-width:none;background:#0e1728}
.projects>.section-heading,.project-list{max-width:1050px;margin-left:auto;margin-right:auto}
.project-list{display:grid;gap:14px}
.project{display:grid;grid-template-columns:190px 1fr;gap:22px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:17px}
.project-art{height:130px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:900;letter-spacing:-2px}
.project-art span{font-size:16px;margin-left:5px;letter-spacing:0}
.chat-art{background:linear-gradient(140deg,#1b5167,#162d49);color:#a8f2e2}
.javelin-art{background:linear-gradient(140deg,#8a5d1b,#273f35);color:#ffe4a0}
.cricket-art{background:linear-gradient(140deg,#1e684e,#1c3147);color:#b5f0bf}
.tag{font-size:10px;font-weight:800;letter-spacing:1.4px;color:var(--green)}
.project-info h3{margin:7px 0}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.steps>div{border-left:2px solid var(--blue);padding:8px 17px}.steps b{color:var(--blue);font-size:13px}.steps h3{margin:6px 0}.steps p{font-size:13px;color:var(--muted)}
.contact-section{margin:35px 8% 75px;padding:45px 7%;border:1px solid var(--line);border-radius:18px;background:linear-gradient(135deg,#15223a,#101827);text-align:center}
.contact-section>p{margin-left:auto;margin-right:auto}.centered{justify-content:center}.small-note{font-size:11px!important}
footer{padding:28px 8%;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
footer p{font-size:12px;color:var(--muted)}
@media(max-width:700px){.topbar{height:65px;padding:0 5%}.brand{font-size:17px}.hero{padding:68px 6% 52px}h1{letter-spacing:-1.3px}.section{padding:52px 6%}.cards{grid-template-columns:1fr}.card{padding:20px}.project{grid-template-columns:1fr;gap:13px}.project-art{height:105px}.steps{grid-template-columns:1fr;gap:8px}.contact-section{margin:20px 5% 50px;padding:35px 6%}.hero-note{line-height:2}footer{padding:24px 6%}}
